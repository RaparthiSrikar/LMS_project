DJANGO_SECRET_KEY=change-me-in-production
USE_SQLITE=false

# Railway Database configuration options
# Option 1: Railway Database URL (Paste DATABASE_URL or DATABASE_PUBLIC_URL from Railway dashboard)
DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway

# Option 2: Individual Postgres settings (also automatically populated on Railway services)
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=containers-us-west-xxx.railway.app
# DB_PORT=5432

STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
